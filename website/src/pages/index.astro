---
import Brand from '../components/Brand.astro';
import LayerDiagram from '../components/LayerDiagram.astro';
import '../styles/home.css';
import { base, origin, repository } from '../../site.config.mjs';

const docs = (slug: string) => `${base}docs/${slug}/`;
const features = [
  {
    number: '01', tag: 'BUILD NATIVELY', title: 'Your project is the starting point.',
    text: 'Discover Python projects and configure FastAPI, Flask and Django entrypoints. Use a plain TOML file when you want explicit control.',
    link: docs('build/configuration'), label: 'Explore configuration',
  },
  {
    number: '02', tag: 'REUSE VERIFIED LAYERS', title: 'Keep the work. Skip the repetition.',
    text: 'Content-addressed caching reuses unchanged application layers. Hash-pinned dependency closures can be cached when their inputs are provably safe.',
    link: docs('start/images-and-dependencies'), label: 'Understand the build',
  },
  {
    number: '03', tag: 'PUBLISH DIRECTLY', title: 'An OCI image. Your registry.',
    text: 'Push to GHCR, Azure Container Registry, Docker Hub or another Registry v2 endpoint. No local Docker daemon in the middle.',
    link: docs('registries/push'), label: 'Publish an image',
  },
];
const reading = [
  { title: 'Start with a working example', text: 'Install, build, validate and run your first image.', link: docs('start/quickstart'), number: '01' },
  { title: 'Make the build yours', text: 'TOML settings, base images, targets and metadata.', link: docs('build/configuration'), number: '02' },
  { title: 'Know what you are shipping', text: 'OCI validation, SBOMs and the optional Grype gate.', link: docs('reference/validation'), number: '03' },
  { title: 'Fit your existing workflow', text: 'GitHub Actions, Poetry, Hatch, Skaffold and Tilt.', link: docs('integrations/github-actions'), number: '04' },
];
const buildCommand = 'pycontainer build --tag myapp:latest';
const installCommands = `git clone https://github.com/spboyer/pycontainer-build.git\ncd pycontainer-build\npython -m pip install --no-deps -e .`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1f2b" />
    <title>pycontainer — Python in. Containers out.</title>
    <meta name="description" content="Build OCI container images from Python projects without Dockerfiles or a Docker daemon. Explore pycontainer's features, source installation and documentation." />
    <link rel="canonical" href={`${origin}${base}`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content="pycontainer — Python in. Containers out." />
    <meta property="og:description" content="Your Python project, packaged as an OCI image. No Dockerfile. No Docker daemon." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${origin}${base}`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base} aria-label="Pycontainer home"><Brand /></a>
        <nav aria-label="Main navigation">
          <a href="#features">Features</a>
          <a href={docs('start/quickstart')}>Docs</a>
          <a class="github-link" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> THE PYTHON-NATIVE OCI IMAGE BUILDER</p>
          <h1 id="hero-title">Python in.<br /><em>Containers out.</em></h1>
          <p class="hero-description">Your code already knows how to be Python.<br class="desktop-break" /> Give it a container, without the build machinery.</p>
          <p class="hero-promise">No Dockerfile. No Docker daemon.</p>
          <div class="hero-actions">
            <a class="button primary" href={docs('start/quickstart')}>Build your first image <span aria-hidden="true">↗</span></a>
            <a class="text-link light" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a>
          </div>
          <p class="project-note">Open source <span aria-hidden="true">/</span> Experimental <span aria-hidden="true">/</span> Python 3.11+</p>
        </div>
        <div class="hero-visual">
          <LayerDiagram />
          <div class="command-preview">
            <div class="command-label"><span>FROM YOUR PROJECT DIRECTORY</span><button type="button" data-copy="hero-command" aria-label="Copy build command">Copy</button></div>
            <pre><span aria-hidden="true" class="prompt">$ </span><code id="hero-command">{buildCommand}</code></pre>
          </div>
        </div>
      </section>

      <div class="fact-strip">
        <div class="container facts">
          <p><span class="fact-label">BUILD ENGINE</span><strong>Python. Not a daemon.</strong></p>
          <p><span class="fact-label">OUTPUT FORMAT</span><strong>Standard OCI images.</strong></p>
          <p><span class="fact-label">YOUR WORKFLOW</span><strong>CLI, TOML or Python API.</strong></p>
        </div>
      </div>

      <section class="features-section" id="features" aria-labelledby="features-title">
        <div class="container feature-layout">
          <div class="section-intro">
            <p class="eyebrow">LESS CEREMONY / MORE CONTROL</p>
            <h2 id="features-title">Built around<br /><em>your Python.</em></h2>
            <p>Not another layer of infrastructure to manage. A focused tool that turns the project you have into the image you need.</p>
            <a class="text-link" href={docs('start/images-and-dependencies')}>Understand the fundamentals <span aria-hidden="true">↗</span></a>
          </div>
          <div class="feature-list">
            {features.map((feature) => (
              <article class="feature-row">
                <span class="feature-number">{feature.number}</span>
                <div>
                  <p class="eyebrow">{feature.tag}</p>
                  <h3>{feature.title}</h3>
                  <p>{feature.text}</p>
                  <a class="text-link" href={feature.link}>{feature.label} <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="workflow-section container" id="how-it-works" aria-labelledby="workflow-title">
        <div class="workflow-heading">
          <div><p class="eyebrow">A SHORT PATH TO AN IMAGE</p><h2 id="workflow-title">Source. Build. <em>Ship.</em></h2></div>
          <p>Pull a base. Stage dependencies when requested.<br />Add your app. Write the OCI layout.</p>
        </div>
        <div class="workflow-grid">
          <div class="install-panel">
            <div class="command-label"><span>01 / INSTALL FROM SOURCE</span><button type="button" data-copy="install-command" aria-label="Copy source installation commands">Copy</button></div>
            <pre><code id="install-command">{installCommands}</code></pre>
            <p>Python 3.11+ required. Package publication is pending; start from a repository checkout.</p>
          </div>
          <div class="workflow-steps">
            <div><span>02</span><div><h3>Build from your project</h3><code>pycontainer build --tag myapp:latest</code><p>Choose your target and stage dependencies explicitly.</p></div></div>
            <div><span>03</span><div><h3>Take it to your registry</h3><code>pycontainer build --tag ghcr.io/you/myapp:v1 --push</code><p>Or keep the OCI layout for validation and import.</p></div></div>
          </div>
        </div>
        <div class="honesty-note">
          <span class="eyebrow">BUILT WITH CLEAR BOUNDARIES</span>
          <p>The builder is experimental. Linux image targets; wheel-only dependency installs; no cross-compilation. Building may need network access. Running the result still needs a container runtime.</p>
          <a class="text-link light" href={docs('reference/limitations')}>Read the limitations <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="docs-section" aria-labelledby="docs-title">
        <div class="container docs-layout">
          <div class="section-intro">
            <p class="eyebrow">THE FIELD GUIDE</p>
            <h2 id="docs-title">Good tools need<br /><em>good docs.</em></h2>
            <p>Practical guides, copyable commands and the details that matter. Start small, then go deeper.</p>
            <a class="button dark" href={docs('start/quickstart')}>Open the documentation <span aria-hidden="true">↗</span></a>
          </div>
          <div class="reading-list">
            {reading.map((guide) => (
              <a class="reading-row" href={guide.link}>
                <span class="reading-number">{guide.number}</span>
                <div><h3>{guide.title}</h3><p>{guide.text}</p></div>
                <span class="reading-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
        <div class="container integration-strip">
          <p class="eyebrow">MEET YOUR EXISTING TOOLCHAIN</p>
          <div>
            <a href={docs('integrations/poetry')}>Poetry</a>
            <a href={docs('integrations/hatch')}>Hatch</a>
            <a href={docs('integrations/github-actions')}>GitHub Actions</a>
            <a href={docs('integrations/skaffold-tilt')}>Skaffold & Tilt</a>
            <a href={docs('integrations/azd')}>Azure Developer CLI</a>
          </div>
        </div>
      </section>

      <section class="closing container" aria-labelledby="closing-title">
        <p class="eyebrow">LESS SETUP. SAME PYTHON.</p>
        <h2 id="closing-title">Your next image starts<br />with <em>your code.</em></h2>
        <a class="button primary" href={docs('start/quickstart')}>Get started <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="container site-footer">
      <a class="brand" href={base} aria-label="Pycontainer home"><Brand /></a>
      <p>Python-native. Daemon-free. Open source.</p>
      <nav aria-label="Footer navigation">
        <a href={docs('start/quickstart')}>Documentation</a>
        <a href={`${repository}/issues`}>Issues</a>
        <a href={repository}>Source <span aria-hidden="true">↗</span></a>
      </nav>
    </footer>
    <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>

    <script>
      document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const code = document.getElementById(button.dataset.copy ?? '');
          const status = document.getElementById('copy-status');
          if (!code || !status) return;
          try {
            await navigator.clipboard.writeText(code.textContent ?? '');
            status.textContent = 'Command copied to clipboard.';
            button.textContent = 'Copied';
            window.setTimeout(() => { button.textContent = 'Copy'; }, 2000);
          } catch {
            status.textContent = 'Clipboard unavailable. Select the command text and copy it manually.';
          }
        });
      });
    </script>
  </body>
</html>
